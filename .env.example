# CareRelay environment variables: names only, never a value.
#
# The names are approved content (`02-architecture.md` section 8, the environment
# variable rows). Copy this file to `.env`, fill the values in there, and keep
# `.env` out of git: `.gitignore` line 20 already ignores it.
#
# **Nothing in this repository reads `.env` automatically.** There is no
# `python-dotenv` dependency, and adding one would be a new dependency the product
# does not need. Either export the variables into the process environment, or set
# them in the host's dashboard. On Render the dashboard is the source of truth and
# this file is irrelevant.

# --- The API -------------------------------------------------------------------

# A Postgres DSN. A DSN carries a password, so this is a secret.
# Use the Supabase **session pooler** (port 5432). The direct connection string is
# IPv6-only and Render is IPv4-only, so it cannot connect from the deployment.
APP_DATABASE_URL=

# `scenario` pins the demo clock so the fixture's deadline does not drift with the
# real date. `system` uses the wall clock.
APP_CLOCK=scenario

# `public` arms the bearer-token guard. With this set and no token configured,
# every protected route answers 503 rather than serving an open endpoint.
APP_ENV=local

# The Vercel origin, and nothing else. A wildcard is refused by the app.
CORS_ORIGINS=

# The shared bearer token. Generate one with `secrets.token_urlsafe(32)`.
CARERELAY_API_TOKEN=


# --- ADP (a submission artefact, not wired into the code) ----------------------
#
# Slice 13, the ADP interpretation surface, is conditional and was NOT run, so no
# module reads these four. They are recorded here because the submission requires
# the published agent and its Experience URL.

# Secret. Never committed, never logged, never screenshotted.
ADP_APPKEY=
# submission.
ADP_EXPERIENCE_URL=https://adp.tencentcloud.com/webim_exp/#/chat/GkTbUc


# The chat endpoint, `https://wss.lke.tencentcloud.com/adp/v2/chat` per the guide.
ADP_CHAT_ENDPOINT=https://wss.lke.tencentcloud.com/adp/v2/chat

# Secret. Required for the WebSocket transport only; HTTP SSE needs the AppKey
# alone.
ADP_API_SECRET=

# --- Tests ---------------------------------------------------------------------

# The Postgres-gated tests skip without this. Point it at the same DSN as
# `APP_DATABASE_URL` to run the 43 tests that otherwise skip, which is the
# strongest available check that the deployed store works.
CARERELAY_TEST_DSN=

